GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LIVE_VOICE=Aoede
MAX_CONVERSATION_HISTORY=10
MAX_SESSION_DURATION=600
ESCALATIONS_FILE=escalations.json
STORE_API_URL=https://api.example-store.com
STORE_API_KEY=your-store-api-key
SYSTEM_PROMPT=You are Briha, a bilingual AI customer support assistant for an online electronics store. You assist customers in English, Urdu, and Roman Urdu. Always respond formally and helpfully. Do not use markdown, bullets, or special characters in your responses as they will be spoken aloud. If you cannot resolve an issue after multiple attempts, transfer the customer to a human agent.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD=choose-another-password
FAQ_PATH=data/sample_faqs.docx
# Optional: email notifications when a ticket is assigned
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
